# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local ne doit JAMAIS être partagé ni commité sur GitHub.

# --- Supabase (comptes élèves) ---
# Projet dédié à Sema (séparé de celui de Trajectoires) — supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Session (identifiant + code d'accès de l'espace élève) ---
# Chaîne aléatoire longue, générée une fois (ex. openssl rand -hex 32)
SESSION_SECRET=

# --- Liens Zoom, un par groupe (jamais envoyés au navigateur avant connexion) ---
ZOOM_LINK_TSHILUBA_DEBUTANT=
ZOOM_LINK_TSHILUBA_INTERMEDIAIRE=
ZOOM_LINK_SWAHILI_DEBUTANT=
ZOOM_LINK_SWAHILI_INTERMEDIAIRE=
ZOOM_LINK_LINGALA_DEBUTANT=
ZOOM_LINK_LINGALA_INTERMEDIAIRE=
ZOOM_LINK_KIKONGO_DEBUTANT=
ZOOM_LINK_KIKONGO_INTERMEDIAIRE=

# --- Liens WhatsApp, un par groupe (jamais envoyés au navigateur avant connexion) ---
WHATSAPP_LINK_TSHILUBA_DEBUTANT=
WHATSAPP_LINK_TSHILUBA_INTERMEDIAIRE=
WHATSAPP_LINK_SWAHILI_DEBUTANT=
WHATSAPP_LINK_SWAHILI_INTERMEDIAIRE=
WHATSAPP_LINK_LINGALA_DEBUTANT=
WHATSAPP_LINK_LINGALA_INTERMEDIAIRE=
WHATSAPP_LINK_KIKONGO_DEBUTANT=
WHATSAPP_LINK_KIKONGO_INTERMEDIAIRE=
